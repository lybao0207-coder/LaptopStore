<%--
    Phần đầu layout khu vực Admin (dùng chung cho mọi trang /admin/*).
    Cách dùng trong trang JSP: dùng chỉ thị include tĩnh (include file) để chèn
        /WEB-INF/views/admin/layout/header.jspf ở ĐẦU trang và
        /WEB-INF/views/admin/layout/footer.jspf ở CUỐI trang
        (xem ví dụ trong /WEB-INF/views/admin/kiem-tra-ket-noi.jsp).
    Thuộc tính request do Servlet đặt trước khi forward:
        tieuDe      : tiêu đề trang (hiện trên tab trình duyệt)
        menuHienTai : "danh-muc" | "thuong-hieu" | "cpu" | "card-do-hoa" | rỗng  -> tô sáng mục menu
    Thông báo một lần (flash) do Servlet đặt vào SESSION trước khi redirect:
        thongBaoThanhCong, thongBaoLoi -> hiện 1 lần rồi tự xóa.
--%>
<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${empty tieuDe ? 'Quản trị' : tieuDe}"/> - LaptopShop Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">

<nav class="navbar navbar-expand-md navbar-dark bg-dark">
    <div class="container-fluid">
        <span class="navbar-brand fw-bold">LaptopShop Admin</span>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuAdmin"
                aria-controls="menuAdmin" aria-expanded="false" aria-label="Mở menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menuAdmin">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link ${menuHienTai == 'danh-muc' ? 'active' : ''}"
                       href="${pageContext.request.contextPath}/admin/danh-muc">Danh mục</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ${menuHienTai == 'thuong-hieu' ? 'active' : ''}"
                       href="${pageContext.request.contextPath}/admin/thuong-hieu">Thương hiệu</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ${menuHienTai == 'cpu' ? 'active' : ''}"
                       href="${pageContext.request.contextPath}/admin/cpu">CPU</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ${menuHienTai == 'card-do-hoa' ? 'active' : ''}"
                       href="${pageContext.request.contextPath}/admin/card-do-hoa">Card đồ họa</a>
                </li>
            </ul>
            <%-- D29: chưa có đăng nhập, chỉ dùng trong môi trường phát triển local --%>
            <span class="badge text-bg-warning">Môi trường phát triển - chưa có đăng nhập</span>
        </div>
    </div>
</nav>

<main class="container py-4">

    <%-- Thông báo một lần (flash): hiện rồi xóa khỏi session --%>
    <c:if test="${not empty sessionScope.thongBaoThanhCong}">
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <c:out value="${sessionScope.thongBaoThanhCong}"/>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
        <c:remove var="thongBaoThanhCong" scope="session"/>
    </c:if>
    <c:if test="${not empty sessionScope.thongBaoLoi}">
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <c:out value="${sessionScope.thongBaoLoi}"/>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
        <c:remove var="thongBaoLoi" scope="session"/>
    </c:if>
